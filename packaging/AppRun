#!/bin/bash
# AppImage entry point for SEO Dashboard

HERE="$(dirname "$(readlink -f "${0}")")"
export APPDIR="${APPDIR:-$HERE}"

# --- Bundled Python runtime ---
export PATH="${APPDIR}/usr/bin:${PATH}"
export PYTHONHOME="${APPDIR}/usr"
# Bundle-provided libs take priority so pip-installed packages work correctly
export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${APPDIR}/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:-}"

# --- User config directory ---
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/seo-dashboard"
mkdir -p "$CONFIG_DIR"

# Create a starter .env on first launch
if [ ! -f "$CONFIG_DIR/.env" ]; then
    cp "${APPDIR}/app/.env.example" "$CONFIG_DIR/.env"
    echo ""
    echo "First launch: config file created at $CONFIG_DIR/.env"
    echo "Edit it to add your API keys, then relaunch."
    echo ""
fi

# Tell core/config.py where to find the .env
export SEO_DASHBOARD_ENV_FILE="$CONFIG_DIR/.env"

# --- Find a free port ---
PORT=8501
while ss -tlnH 2>/dev/null | grep -q ":${PORT} \|:${PORT}$"; do
    PORT=$((PORT + 1))
done

# --- Launch Streamlit ---
export STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
export STREAMLIT_SERVER_HEADLESS=true
export STREAMLIT_SERVER_PORT="$PORT"
export STREAMLIT_SERVER_FILE_WATCHER_TYPE=none

cd "${APPDIR}/app"
"${APPDIR}/usr/bin/python3" -m streamlit run app.py \
    --server.port "$PORT" \
    --server.headless true \
    --server.fileWatcherType none \
    --browser.gatherUsageStats false &
STREAMLIT_PID=$!

# Kill Streamlit when AppImage exits
cleanup() { kill "$STREAMLIT_PID" 2>/dev/null; wait "$STREAMLIT_PID" 2>/dev/null; }
trap cleanup EXIT INT TERM

# --- Wait for server to be ready (max 15 s) ---
URL="http://localhost:${PORT}"
for i in $(seq 1 30); do
    if curl -sf "${URL}/_stcore/health" >/dev/null 2>&1; then
        break
    fi
    sleep 0.5
done

# --- Open browser ---
if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$URL" 2>/dev/null &
elif command -v x-www-browser >/dev/null 2>&1; then
    x-www-browser "$URL" 2>/dev/null &
fi

echo "SEO Dashboard running at ${URL}"
echo "Press Ctrl+C to stop."

wait "$STREAMLIT_PID"
