# SEO API configuration (SEMrush)
SEO_API_KEY=your_api_key_here
SEO_API_BASE_URL=https://api.semrush.com

# Google Search Console (run `python scripts/gsc_auth.py` to generate these)
GSC_CREDENTIALS_PATH=~/path/to/credentials.json
GSC_TOKEN_PATH=~/.seo_dashboard/gsc_token.json

# Cache settings
CACHE_DIR=~/.seo_dashboard/cache
CACHE_TTL_HOURS=24

# Defaults
DEFAULT_LANGUAGE=en
DEFAULT_LOCATION_ID=2840
MAX_KEYWORDS=100

# Report output directory
REPORT_OUTPUT_DIR=./reports_output
